include(GNUInstallDirs)
find_package(Intl REQUIRED)
file(RELATIVE_PATH SCRCTL_RELATIVE_LOCALEDIR
    "${CMAKE_INSTALL_FULL_BINDIR}" "${CMAKE_INSTALL_FULL_LOCALEDIR}")
find_package(Gettext REQUIRED)

set(SCRCTL_TRANSLATION_OUTPUT "${CMAKE_BINARY_DIR}/locale/zh_CN/LC_MESSAGES/scrctl.mo")
add_custom_command(OUTPUT "${SCRCTL_TRANSLATION_OUTPUT}"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_BINARY_DIR}/locale/zh_CN/LC_MESSAGES"
    COMMAND "${GETTEXT_MSGFMT_EXECUTABLE}" --check --check-format
            -o "${SCRCTL_TRANSLATION_OUTPUT}" "${PROJECT_SOURCE_DIR}/po/zh_CN.po"
    DEPENDS "${PROJECT_SOURCE_DIR}/po/zh_CN.po"
    VERBATIM)
add_custom_target(scrctl_translations ALL DEPENDS "${SCRCTL_TRANSLATION_OUTPUT}")
install(FILES "${SCRCTL_TRANSLATION_OUTPUT}"
        DESTINATION "${CMAKE_INSTALL_LOCALEDIR}/zh_CN/LC_MESSAGES")

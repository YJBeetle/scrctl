msgstr "用 .mp4 或 .mkv 保存所选音视频轨道；其他扩展名保存不含音频的裸 HEVC"

#: src/app/Cli.cpp:49
msgid ""
"Launch bundle ID; ? matches name prefix, + terminates the previous instance"
msgstr "启动 bundle id；? 按名称前缀，+ 先终止实例"

#: src/app/Cli.cpp:50
msgid "Window title"
msgstr "窗口标题"

#: src/app/Cli.cpp:51
msgid "SDL render driver, e.g. metal / software"
msgstr "SDL 渲染驱动，如 metal / software"

#: src/app/Cli.cpp:53
msgid ""
"display for live video (default), screenshot for polling; stream is an alias "
"for display"
msgstr ""
"display 为实时视频（默认），screenshot 为截图轮询；stream 是 display 的别名"

#: src/app/Cli.cpp:55
msgid "Inject X0,Y0,X1,Y1 swipe and exit (normalized coordinates)"
msgstr "注入直线 X0,Y0,X1,Y1 后退出（归一化坐标）"

#: src/app/Cli.cpp:62
msgid "Inject home/lock/volup/voldn/mute"
msgstr "注入 home/lock/volup/voldn/mute"

#: src/app/Cli.cpp:64
msgid "Inject ASCII text (device text field must have focus)"
msgstr "注入 ASCII 文本（设备需已聚焦文本框）"

#: src/app/Cli.cpp:65
msgid "Force alternating video fallback and recovery at T1,T2,... seconds"
msgstr "按 T1,T2,... 秒交替强制降级与恢复"

#: src/app/Cli.cpp:66
msgid "Write device clipboard and exit (supports Unicode)"
msgstr "写入设备剪贴板后退出（支持中文）"

#: src/app/Cli.cpp:68
msgid "List USB and RemotePairing devices; wireless scan defaults to 3 seconds"
msgstr "列出 USB 与 RemotePairing 设备；默认扫描无线设备 3 秒"

#: src/app/Cli.cpp:70
msgid ""
"Wireless discovery timeout in milliseconds (0..60000); 0 lists usbmux only"
msgstr "无线设备扫描时间，单位毫秒（0..60000）；0 表示只列出 usbmux 设备"

#: src/app/Cli.cpp:72
msgid "Disable input control"
msgstr "关闭输入控制"

#: src/app/Cli.cpp:75
msgid "List device apps"
msgstr "列出设备 App"

#: src/app/Cli.cpp:76
msgid "Show version"
msgstr "显示版本"

#: src/app/Cli.cpp:77
msgid "Desktop fullscreen"
msgstr "桌面全屏"

#: src/app/Cli.cpp:78
msgid "Keep window on top"
msgstr "窗口置顶"

#: src/app/Cli.cpp:79
msgid "Borderless window"
msgstr "无边框窗口"

#: src/app/Cli.cpp:80
msgid "Prevent local screen sleep while running"
msgstr "运行期间禁止本机息屏"

#: src/app/Cli.cpp:81
msgid "Do not start audio stream"
msgstr "不启动音频流"

#: src/app/Cli.cpp:83
msgid "Keep audio playing on the phone while forwarding it to the computer"
msgstr "转发音频到电脑，同时保留手机播放"

#: src/app/Cli.cpp:86
msgid ""
"Disable computer audio playback; capture audio only when recording to MP4 or "
"MKV"
msgstr "关闭电脑音频播放；仅录制 MP4 或 MKV 时采集音频"

#: src/app/Cli.cpp:87
msgid "Do not start video stream"
msgstr "不采集视频"

#: src/app/Cli.cpp:89
msgid "Disable video display; keep encoded video when recording"
msgstr "不显示视频；录制时仍接收编码视频"

#: src/app/Cli.cpp:92
msgid ""
"Disable computer video and audio playback; keep selected recording tracks"
msgstr "不在电脑播放视频或音频；录制时保留所选轨道"

#: src/app/Cli.cpp:93
msgid "Run without a window"
msgstr "无窗口运行"

#: src/app/Cli.cpp:94
msgid "Use platform hardware decoder; default: software"
msgstr "使用平台硬件解码，默认软件解码"

#: src/app/Cli.cpp:95
msgid "Print input coordinates"
msgstr "打印输入坐标"

#: src/app/Cli.cpp:96
msgid "Add tunnel diagnostics to --stats"
msgstr "在 --stats 中增加隧道网络诊断"

#: src/app/Cli.cpp:97
msgid "Print statistics every second"
msgstr "每秒打印统计"

#: src/app/Cli.cpp:98
msgid "Read device clipboard; with --copy, read back after writing"
msgstr "读取设备剪贴板；与 --copy 同用时写后读回"

#: src/app/Cli.cpp:101
msgid "Window horizontal position; integer or auto (default)"
msgstr "窗口横坐标：整数或 auto（默认）"

#: src/app/Cli.cpp:103
msgid "Window vertical position; integer or auto (default)"
msgstr "窗口纵坐标：整数或 auto（默认）"

#: src/app/Cli.cpp:105
msgid ""
"Shortcut modifiers, separated by commas: lctrl, rctrl, lalt, ralt, lsuper, "
"rsuper; default: lalt,lsuper"
msgstr ""
"快捷键修饰键，用逗号分隔：lctrl、rctrl、lalt、ralt、lsuper、rsuper；默认 "
"lalt,lsuper"

#: src/app/Cli.cpp:106
msgid "Window width; 0 for automatic"
msgstr "窗口宽度，0 为自动"

#: src/app/Cli.cpp:107
msgid "Window height; 0 for automatic"
msgstr "窗口高度，0 为自动"

#: src/app/Cli.cpp:108
msgid "Run duration in seconds; 0 for unlimited"
msgstr "运行秒数，0 为不限"

#: src/app/Cli.cpp:110
msgid "Audio buffer in milliseconds; default: 50, maximum: 1000"
msgstr "音频缓冲毫秒数，默认 50，上限 1000"

#: src/app/Cli.cpp:112
msgid "Exit after N frames; 0 for unlimited"
msgstr "处理 N 帧后退出，0 为不限"

#: src/app/Cli.cpp:114
msgid "Finite positive scale; default: fit screen"
msgstr "有限正数缩放比例，默认自动适应屏幕"

#: src/app/Cli.cpp:132
msgid ""
"Display and recording orientation: 0/90/180/270 or flip0/flip90/flip180/"
"flip270; recording cannot flip; auto changes display only"
msgstr ""
"显示和录制方向：0/90/180/270 或 flip0/flip90/flip180/flip270；录制不支持翻"
"转，auto 只设置显示"

#: src/app/Cli.cpp:136
msgid ""
"Display orientation: auto, 0/90/180/270 or flip0/flip90/flip180/flip270; "
"flip horizontally before clockwise rotation"
msgstr ""
"显示方向：auto、0/90/180/270 或 flip0/flip90/flip180/flip270；先水平翻转，再"
"顺时针旋转"

#: src/app/Cli.cpp:140
msgid ""
"Clockwise MP4/MKV recording rotation: 0/90/180/270; default: 0; display is "
"unchanged"
msgstr "顺时针旋转 MP4/MKV 录制：0/90/180/270，默认 0；不改变显示"

#: src/app/Cli.cpp:143
msgid "Crop displayed pixels: WxH+X+Y or W:H:X:Y; recording is unchanged"
msgstr "裁剪显示像素：WxH+X+Y 或 W:H:X:Y；不改变录制内容"

#: src/app/Cli.cpp:145
msgid "Background color: RGB or RRGGBB, with optional #"
msgstr "背景色：RGB 或 RRGGBB，可带 # 前缀"

#: src/app/Cli.cpp:146
msgid "Read window at frame N into BMP: N FILE (requires a window)"
msgstr "第 N 帧回读窗口为 BMP：N FILE（需要窗口）"

#: src/app/Cli.cpp:160
msgid ""
"Audio capture is disabled; --audio-dup requires playback or MP4/MKV recording"
msgstr "音频采集已关闭；--audio-dup 需要电脑播放或 MP4/MKV 音轨录制"

#: src/app/Cli.cpp:166
msgid ""
"File playback requires video; incompatible with video playback disable "
"options"
msgstr "文件播放需要视频，不能同时指定关闭视频播放的选项"

#: src/app/Cli.cpp:174
msgid "Audio-only recording requires MP4 or MKV; raw HEVC cannot contain audio"
msgstr "仅录音频需要使用 MP4 或 MKV；裸 HEVC 无法保存音频"

#: src/app/Cli.cpp:177
msgid "Recording requires at least one enabled audio or video track"
msgstr "录制需要至少启用音频或视频中的一项"

#: src/app/Cli.cpp:180 src/app/LiveSource.cpp:91
msgid "Recording orientation requires a video track"
msgstr "录制方向需要视频轨道"

#: src/app/Cli.cpp:185
msgid ""
"Frame counting, hardware decoding, fallback tests and screenshots require "
"video capture"
msgstr "按帧计数、硬件解码、降级测试和截图需要采集视频"

#: src/app/Cli.cpp:189 src/app/LiveSource.cpp:113
msgid ""
"Container recording requires live video; screenshot polling cannot be "
"recorded"
msgstr "容器录制需要实时视频流，不能录制截图轮询"

#: src/app/Cli.cpp:193
msgid ""
"Recording does not support flipping; use --display-orientation for display-"
"only flipping or reset --record-orientation to a rotation"
msgstr ""
"录制不支持翻转；只翻转显示请使用 --display-orientation，或在后面用 --record-"
"orientation 指定旋转角度"

#: src/app/Cli.cpp:197 src/app/LiveSource.cpp:123
msgid ""
"Recording rotation requires MP4 or MKV; use --display-orientation to rotate "
"only the display"
msgstr "录制旋转需要 MP4 或 MKV；只旋转显示请使用 --display-orientation"

#: src/app/Cli.cpp:200
msgid "Use a manual LAN address; auto uses discovered SRV ports"
msgstr "用于手动指定的局域网地址；auto 使用广播的 SRV 端口"

#: src/app/Cli.cpp:211
msgid "Expected an integer or auto"
msgstr "请使用整数或 auto"

#: src/app/Cli.cpp:231
msgid ""
"Use a comma-separated list of lctrl, rctrl, lalt, ralt, lsuper or rsuper"
msgstr "请使用 lctrl、rctrl、lalt、ralt、lsuper 或 rsuper，以逗号分隔"

#: src/app/Cli.cpp:242
msgid "Coordinates must be finite numbers in [0, 1]"
msgstr "坐标必须是 [0, 1] 内的有限数"

#: src/app/Cli.cpp:249
msgid "Requires a finite positive number"
msgstr "需要有限正数"

#: src/app/Cli.cpp:264
msgid ""
"Expected WxH+X+Y or W:H:X:Y, with positive dimensions and nonnegative offsets"
msgstr "格式应为 WxH+X+Y 或 W:H:X:Y，尺寸为正、偏移非负"

#: src/app/Cli.cpp:273
msgid "Expected 3 or 6 hexadecimal digits, optionally prefixed with #"
msgstr "请使用 3 位或 6 位十六进制颜色，可带 # 前缀"


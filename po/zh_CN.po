msgid "Device clipboard text did not match; paste skipped"
msgstr "手机剪贴板内容与发送文本不一致，未执行粘贴"

#: src/app/Application.cpp:230
#, c-format
msgid ""
"Failed to open audio output: %s (recording and audio reception continue)\n"
msgstr "打开音频输出失败：%s（录制和音频接收继续）\n"

#: src/app/Application.cpp:233
#, c-format
msgid "Failed to open audio output: %s\n"
msgstr "无法打开音频输出：%s\n"

#: src/app/Application.cpp:237
#, c-format
msgid ""
"Failed to open audio output: %s (audio disabled; video continues). The "
"phone's audio route may remain active until session expiry (about 20 "
"seconds); resume its player if needed.\n"
msgstr ""
"打开音频输出失败：%s（已禁用音频，视频继续）。手机音频路由可能保持到会话到期"
"（约 20 秒）；如有需要，请在手机上继续播放。\n"

#: src/app/Application.cpp:244
#, c-format
msgid ""
"Local audio playback disabled; recording original AAC without PCM decoding\n"
msgstr "电脑音频播放已关闭；直接录制原始 AAC，不解码为 PCM\n"


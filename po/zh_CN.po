msgstr "已完成：音频录制已保存\n"

#: src/app/Application.cpp:582
#, c-format
msgid "Finished: device session closed\n"
msgstr "已结束：设备会话已关闭\n"

#: src/app/Application.cpp:585
#, c-format
msgid "Finished: encoded video recording finalized\n"
msgstr "结束：编码视频录制已完成收尾\n"

#: src/app/Application.cpp:587
#, c-format
msgid "Finished: processed %d frames\n"
msgstr "完成：处理 %d 帧\n"

#: src/app/AudioOut.cpp:11 src/app/LiveSource.cpp:405

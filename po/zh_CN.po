#, c-format
msgid ""
"  +%-6llu ms  Video recovered from fallback (restarts=%llu decoded=%llu)\n"
msgstr "  +%-6llu ms  视频已从降级状态恢复（重建次数=%llu 已解码帧数=%llu）\n"


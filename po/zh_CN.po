#, c-format
msgid "Failed to start device session: %s\n"
msgstr "无法启动设备会话：%s\n"

#: src/app/Application.cpp:172
#, c-format
msgid "Device is in a call. End the call and try again.\n"
msgstr "设备正在通话，请结束通话后重试。\n"

#: src/app/Application.cpp:193
#, c-format
msgid "File playback cannot launch a device app; ignoring --start-app\n"
msgstr "文件回放模式无法启动设备应用，已忽略 --start-app\n"


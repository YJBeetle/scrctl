msgid ""
"--keep-pli requires --fail-decode and is incompatible with --fail-every-"
"keyframe\n"
msgstr "--keep-pli 需要 --fail-decode，且不能与 --fail-every-keyframe 同用\n"

#: tools/stall_probe.cpp:104
#, c-format
msgid ""
"--ignore-video-after(%d) must exceed --drop-at-packet(%d) + 40 so later "
"packets can reveal the sequence gap\n"
msgstr ""
"--ignore-video-after(%d) 必须大于 --drop-at-packet(%d) + 40，以便接收后续视频"
"包并识别序号缺口\n"


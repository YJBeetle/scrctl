msgstr "回放 Annex-B HEVC 文件"

#: src/app/Cli.cpp:35 tools/screenshot_probe.cpp:58 tools/stall_probe.cpp:61
msgid "Device UDID"
msgstr "设备 UDID"

#: src/app/Cli.cpp:36
msgid "LAN address, or auto to discover a paired wireless device"
msgstr "局域网地址；设为 auto 可自动发现已配对的无线设备"

#: src/app/Cli.cpp:38
msgid "RemotePairing port for a manual LAN address; default: 49152"
msgstr "手动指定局域网地址时使用的 RemotePairing 端口，默认 49152"

#: src/app/Cli.cpp:41
msgid "Create or verify a remote pairing record over USB, then exit"
msgstr "通过 USB 创建或验证远程配对记录，然后退出"

#: src/app/Cli.cpp:44
msgid ""
"Allow replacing an incomplete or rejected pairing record; requires --pair"
msgstr "允许替换不完整或被设备拒绝的配对记录；需要 --pair"

